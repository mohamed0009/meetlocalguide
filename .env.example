# Local database defaults
POSTGRES_DB=meetlocalguide
POSTGRES_USER=meetlocalguide
POSTGRES_PASSWORD=meetlocalguide

# Backend runtime
DB_URL=jdbc:postgresql://postgres:5432/meetlocalguide
DB_USERNAME=meetlocalguide
DB_PASSWORD=meetlocalguide
APP_JWT_ISSUER=meetlocalguide
APP_JWT_SECRET=change-this-with-a-secure-base64-secret
APP_CORS_ALLOWED_ORIGIN_PRIMARY=https://meetlocalguide.com
APP_CORS_ALLOWED_ORIGIN_SECONDARY=https://www.meetlocalguide.com

# Frontend runtime
NEXT_PUBLIC_API_BASE_URL=https://meetlocalguide.com/api/v1
NEXT_PUBLIC_MAPBOX_TOKEN=your-mapbox-public-token

# VPS image references (used by docker-compose.vps.yml)
BACKEND_IMAGE=ghcr.io/owner/repo-backend:latest
FRONTEND_IMAGE=ghcr.io/owner/repo-frontend:latest
BACKEND_PORT=8080
FRONTEND_PORT=3000
POSTGRES_PORT=5432
